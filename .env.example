# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Токен платёжного провайдера (необязательно). Если оставить пустым — магазин
# работает в режиме "ручного заказа": клиент оставляет контакты, вы сами
# согласовываете оплату вне Telegram. Как только появится провайдер (нужен ИП
# или самозанятость), впишите токен сюда — оплата картой включится сама.
PROVIDER_TOKEN=

# Публичный HTTPS-адрес, на котором будет открываться Mini App
WEBAPP_URL=https://your-domain.example

# Telegram chat_id администратора — сюда будут падать заказы
ADMIN_CHAT_ID=123456789

# Валюта заказов (ISO 4217)
CURRENCY=RUB

# Порт aiohttp-сервера (Render подставит свой через переменную PORT)
PORT=8080
